# LandSphere AI — Environment Configuration Template
# Copy this file to .env and configure for your local/deployment environment.
# DO NOT commit real secrets, API keys, or production credentials to source control.

# ==============================================================================
# Server & Runtime Configuration
# ==============================================================================
NODE_ENV=development
PORT=3000

# ==============================================================================
# Authentication & Security
# ==============================================================================
# Secret key used for signing JWT session tokens (minimum 32 characters).
# If omitted in demo mode, a secure local fallback is used.
JWT_SECRET=landsphere-dev-secret-key-change-in-production

# Primary admin identity for bootstrap and initial ownership
OWNER_OPEN_ID=demo-admin-owner

# ==============================================================================
# Database Configuration (Prompt 11 — Postponed / Optional)
# ==============================================================================
# If DATABASE_URL is not set or unavailable, LandSphere AI runs in demo mode
# using high-fidelity in-memory canonical datasets and full PostGIS-compatible APIs.
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:password@localhost:5432/landsphere_ai

# ==============================================================================
# Client & External Services (Optional / Synthetic Demo)
# ==============================================================================
VITE_APP_ID=landsphere-ai

# OAuth server URL (optional; demo authentication is enabled by default)
OAUTH_SERVER_URL=

# Built-in GIS / Mapping Proxy (optional)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
